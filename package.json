{
	"name": "profile",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "concurrently -n path,next --hide path \"pnpm dev:path\" \"pnpm dev:next\"",
		"dev:next": "next dev",
		"dev:path": "pathpida -p .gitignore -o app -ws",
		"dev:turbo": "next dev --turbo",
		"build": "pathpida -p .gitignore -o app -s && next build",
		"t:dev": "turbo dev",
		"t:build": "turbo build",
		"start": "next start",
		"test": "pnpm exec playwright test",
		"pw:open": "pnpm exec playwright test --ui",
		"pw:update": "pnpm exec playwright test --update-snapshots",
		"lint": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"update:latest": "pnpm update --latest --interactive",
		"update:env": "vercel env pull .env.local"
	},
	"dependencies": {
		"@react-three/drei": "10.7.9",
		"@react-three/fiber": "9.8.2",
		"@vercel/analytics": "2.0.1",
		"clsx": "2.1.1",
		"leva": "0.10.1",
		"next": "16.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-use": "17.6.1",
		"three": "0.187.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@next/eslint-plugin-next": "16.4.6",
		"@playwright/test": "1.65.0",
		"@tailwindcss/postcss": "4.3.5",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.187.0",
		"@typescript-eslint/eslint-plugin": "8.72.2",
		"@typescript-eslint/parser": "8.72.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"concurrently": "10.0.7",
		"eslint": "10.14.0",
		"eslint-config-next": "16.4.6",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.7",
		"pathpida": "0.28.0",
		"postcss": "8.5.32",
		"prettier": "3.10.1",
		"tailwindcss": "4.3.5",
		"turbo": "2.11.11",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "8.72.2",
		"vercel": "65.15.0"
	},
	"engines": {
		"node": "20.x || 22.x || 24.x || 26.x"
	}
}
